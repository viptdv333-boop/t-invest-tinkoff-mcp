# Токен T-Invest API (https://www.tbank.ru/invest/settings/api/)
TINKOFF_TOKEN=
# Номер счёта (если пусто — первый счёт токена)
TINKOFF_ACCOUNT_ID=
# 1 — песочница T-Invest, 0 — боевой счёт
TINVEST_SANDBOX=0
# 1 — торговые инструменты включены (по умолчанию), 0 — только чтение
TINVEST_ALLOW_TRADING=1
